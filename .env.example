# copy to .env, fill in, then run: node scripts/gen-config.mjs
# this regenerates js/config.js which the extension reads at runtime.
#
# --- GitHub Gist sync (single-user, no backend) ---------------------------
# 1. Create a SECRET gist on https://gist.github.com (one file, any content —
#    the extension will manage a glisters-save.json file inside it).
# 2. Copy the gist id (the long base62 string from the gist URL) here.
# 3. Create a classic personal access token at
#    https://github.com/settings/tokens — scope: "gist" ONLY.
#    (Fine-grained tokens work too; allow read+write to that one gist.)
GIST_ID=
GITHUB_TOKEN=

# optional: wallhaven API key — unlocks the NSFW purity option (see README).
# Get one at https://wallhaven.cc/settings/account. Leave blank to keep NSFW
# disabled.
WALLHAVEN_API_KEY=
