{
  "manifest_version": 3,
  "name": "Glisters \u2014 New Tab",
  "description": "Minimal keyboard-first new tab with a shortcut grid, synced via GitHub Gist.",
  "version": "2.0.1",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "glisters@firozchauhan.dev",
      "strict_min_version": "140.0"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Glisters",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Open Glisters"
    }
  },
  "permissions": [
    "storage",
    "bookmarks"
  ],
  "host_permissions": [
    "https://*/*",
    "https://api.github.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src https: data: blob:; connect-src 'self' https:;"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
