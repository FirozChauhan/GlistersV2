{
  "name": "glisters",
  "version": "2.0.1",
  "description": "Keyboard-first new tab extension (single-user, GitHub Gist sync)",
  "scripts": {
    "gen-config": "node scripts/gen-config.mjs",
    "gen-icons": "node scripts/gen-icons.mjs",
    "build:ts": "node scripts/build-ts.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run gen-config && npm run gen-icons && npm run build:ts",
    "build:all": "npm run build && npm run build:firefox",
    "build:firefox": "node scripts/build-firefox.mjs",
    "lint:firefox": "npx --yes web-ext lint --source-dir dist/firefox",
    "build:test": "node scripts/build-test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FirozChauhan/Glisters.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/FirozChauhan/Glisters/issues"
  },
  "homepage": "https://github.com/FirozChauhan/Glisters#readme",
  "private": "true",
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
